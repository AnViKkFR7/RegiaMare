{
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.regiamare.com" }], "destination": "https://regiamare.com/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/property/:reference", "destination": "/api/property?reference=:reference" },
    { "source": "/purchases", "destination": "/api/catalog" },
    {
      "source": "/:path*",
      "destination": "/api/page?path=/:path*"
    }
  ]
}
